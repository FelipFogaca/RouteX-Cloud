# RouteX Cloud 3.0
NODE_ENV=development
PORT=3000

# Use uma frase longa, aleatória e exclusiva em produção.
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria

# PostgreSQL persistente. Na Vercel, conecte Neon/Supabase/Prisma Postgres e copie a URL fornecida.
DATABASE_URL=postgresql://usuario:senha@host:5432/routex?sslmode=require
# Alternativa aceita se o provedor expuser POSTGRES_URL em vez de DATABASE_URL.
# POSTGRES_URL=postgresql://usuario:senha@host:5432/routex?sslmode=require
# Use false somente se estiver rodando PostgreSQL local sem SSL.
DATABASE_SSL=true
DB_POOL_MAX=5

# Administrador inicial. O sistema só usa ADMIN_INITIAL_PASSWORD para criar o admin caso o e-mail ainda não exista.
# Depois do primeiro deploy bem-sucedido, remova ADMIN_INITIAL_PASSWORD da Vercel.
ADMIN_EMAIL=admin@belametais.com.br
ADMIN_NAME=Administrador RouteX
ADMIN_INITIAL_PASSWORD=troque-esta-senha-inicial

# Geocodificação/roteirização sem chave Google.
GEOCODING_PROVIDER=nominatim
GEOCODING_STRATEGY=balanced
GEOCODING_PRECISE_LIMIT=12
NOMINATIM_USER_AGENT=RouteX-BelaMetais/3.0
NOMINATIM_INTERVAL_MS=1100
NOMINATIM_TIMEOUT_MS=4500
CEP_COORDINATES_TIMEOUT_MS=4500

ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MAX_POINTS=100
MAPS_MAX_POINTS_PER_LINK=10
HAVERSINE_ROAD_FACTOR=1.25
HAVERSINE_AVERAGE_SPEED_KMH=45

# Vercel Private Blob para anexos XLSX enviados manualmente na agenda.
# Ao conectar um Blob privado pela Vercel, a autenticação pode ser configurada automaticamente/OIDC.
# Para desenvolvimento local, execute `vercel link` e `vercel env pull` se quiser testar anexos.
