<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · RouteX</title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/topbar',{activePage:'admin'}) %><main class="page-shell"><div class="page-heading"><div><span class="eyebrow">Administração RouteX</span><h1>Visão geral da plataforma</h1><p>Gerencie usuários, consulte todo o histórico de rotas e acompanhe todos os agendamentos do veículo.</p></div></div><%- include('partials/messages') %>
<section class="admin-kpis"><div class="metric"><span>Usuários</span><strong><%= users.length %></strong></div><div class="metric"><span>Rotas registradas</span><strong><%= routes.length %></strong></div><div class="metric"><span>Agendamentos</span><strong><%= appointments.length %></strong></div><div class="metric"><span>Reservas ativas</span><strong><%= appointments.filter(a=>a.status==='active').length %></strong></div></section>
<section class="card" id="users"><div class="card-heading"><div><span class="step-badge">U</span><div><h2>Usuários cadastrados</h2><p>O administrador pode definir uma senha provisória. O usuário será obrigado a trocá-la no próximo login.</p></div></div></div><div class="table-wrapper"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Criado em</th><th>Senha provisória</th></tr></thead><tbody><% users.forEach(function(u){ %><tr><td><strong><%= u.name %></strong></td><td><%= u.email %></td><td><span class="status-chip <%= u.role==='admin'?'status-admin':'' %>"><%= u.role==='admin'?'Admin':'Usuário' %></span><% if(u.must_change_password){ %><br><small>Troca de senha pendente</small><% } %></td><td><%= formatDateTime(u.created_at) %></td><td><form class="inline-reset" method="post" action="/admin/users/<%= u.id %>/reset-password"><input type="password" name="temporaryPassword" minlength="8" required placeholder="Senha provisória"><button class="button button-small button-secondary">Definir</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="card" id="routes"><div class="card-heading"><div><span class="step-badge">R</span><div><h2>Todas as rotas</h2><p>Histórico consolidado de todos os usuários.</p></div></div></div><div class="table-wrapper"><table><thead><tr><th>Data</th><th>Usuário</th><th>Rota</th><th>Paradas</th><th>Distância</th><th>Acesso</th></tr></thead><tbody><% if(!routes.length){ %><tr><td colspan="6" class="empty-table">Nenhuma rota registrada.</td></tr><% } %><% routes.forEach(function(r){ %><tr><td><%= formatDateTime(r.generated_at) %></td><td><%= r.user_name %><br><small><%= r.user_email %></small></td><td><%= r.title %></td><td><%= r.summary_json?.stopCount||0 %></td><td><%= formatDistance(r.total_distance_meters) %></td><td><a class="button button-small button-secondary" href="/routes/<%= r.id %>">Abrir</a></td></tr><% }) %></tbody></table></div></section>
<section class="card" id="appointments"><div class="card-heading"><div><span class="step-badge">A</span><div><h2>Todos os agendamentos</h2><p>Reservas do veículo criadas por qualquer usuário.</p></div></div><a href="/schedule">Calendário</a></div><div class="table-wrapper"><table><thead><tr><th>Status</th><th>Período</th><th>Usuário</th><th>Título</th><th>Rota</th><th>Ação</th></tr></thead><tbody><% if(!appointments.length){ %><tr><td colspan="6" class="empty-table">Nenhum agendamento.</td></tr><% } %><% appointments.forEach(function(a){ %><tr><td><span class="status-chip <%= a.status==='active'?'status-ok':'' %>"><%= a.status==='active'?'Ativo':'Cancelado' %></span></td><td><%= formatDateTime(a.start_at) %><br><small>até <%= formatDateTime(a.end_at) %></small></td><td><%= a.user_name %><br><small><%= a.user_email %></small></td><td><strong><%= a.title %></strong></td><td><% if(a.route_id){ %><a href="/routes/<%= a.route_id %>"><%= a.route_title||'Rota' %></a><% } %></td><td><a class="button button-small button-secondary" href="/schedule/<%= a.id %>/edit">Editar</a></td></tr><% }) %></tbody></table></div></section></main></body></html>
