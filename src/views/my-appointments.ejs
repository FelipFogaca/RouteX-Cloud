<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · RouteX</title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/topbar',{activePage:'mine'}) %><main class="page-shell"><div class="page-heading"><div><span class="eyebrow">Minhas reservas</span><h1>Meus agendamentos</h1><p>Edite informações ou cancele reservas. Em séries diárias, você também pode cancelar as ocorrências futuras.</p></div><a class="button button-primary" href="/schedule/new">+ Agendar veículo</a></div><%- include('partials/messages') %><section class="card"><div class="table-wrapper"><table><thead><tr><th>Status</th><th>Período</th><th>Título</th><th>Rota</th><th>Recorrência</th><th>Ações</th></tr></thead><tbody><% if(!appointments.length){ %><tr><td colspan="6" class="empty-table">Nenhum agendamento.</td></tr><% } %><% appointments.forEach(function(a){ %><tr><td><span class="status-chip <%= a.status==='active'?'status-ok':'' %>"><%= a.status==='active'?'Ativo':'Cancelado' %></span></td><td><%= formatDateTime(a.start_at) %><br><small>até <%= formatDateTime(a.end_at) %></small></td><td><strong><%= a.title %></strong><% if(a.notes){ %><br><small><%= a.notes %></small><% } %></td><td><% if(a.route_id){ %><a href="/routes/<%= a.route_id %>"><%= a.route_title||'Rota gerada' %></a><% } %><% if(a.manual_route_url){ %><br><a href="<%= a.manual_route_url %>" target="_blank" rel="noopener">Link adicional ↗</a><% } %></td><td><%= a.recurrence_type==='daily'?'Diário':'Único' %></td><td><div class="inline-actions"><% if(a.status==='active'){ %><a class="button button-small button-secondary" href="/schedule/<%= a.id %>/edit">Editar</a><form method="post" action="/schedule/<%= a.id %>/cancel" onsubmit="return confirm('Cancelar este agendamento?')"><button class="button button-small button-danger" type="submit">Cancelar</button></form><% if(a.series_id){ %><form method="post" action="/schedule/<%= a.id %>/cancel-series" onsubmit="return confirm('Cancelar esta e todas as ocorrências futuras da série?')"><button class="button button-small button-ghost" type="submit">Cancelar série</button></form><% } %><% } %></div></td></tr><% }) %></tbody></table></div></section></main></body></html>
