<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · RouteX</title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/topbar',{activePage:'routes'}) %><main class="page-shell"><div class="page-heading"><div><span class="eyebrow">Rota arquivada · <%= formatDateTime(route.generated_at) %></span><h1><%= route.title || 'Rota gerada' %></h1><p><%= route.user_name %> · <%= route.provider %> · <%= route.algorithm %></p></div><div class="inline-actions"><a class="button button-secondary" href="/routes/<%= route.id %>/export.xlsx">Baixar XLSX</a><% (route.map_links_json||[]).forEach(function(link){ %><a class="button button-maps" href="<%= link.url %>" target="_blank">Maps <%= link.part %> ↗</a><% }) %></div></div><%- include('partials/messages') %><section class="card"><div class="metrics-grid"><div class="metric"><span>Paradas</span><strong><%= route.summary_json?.stopCount || 0 %></strong></div><div class="metric"><span>NF-e</span><strong><%= route.summary_json?.nfCount || 0 %></strong></div><div class="metric"><span>Volumes</span><strong><%= formatNumber(route.summary_json?.volumes || 0,0) %></strong></div><div class="metric"><span>Peso</span><strong><%= formatNumber(route.summary_json?.grossWeight || 0,2) %> kg</strong></div><div class="metric"><span>Distância</span><strong><%= formatDistance(route.total_distance_meters) %></strong></div><div class="metric"><span>Tempo</span><strong><%= formatDuration(route.total_duration_seconds) %></strong></div></div><div class="table-wrapper"><table><thead><tr><th>#</th><th>PV</th><th>NF</th><th>Destinatário</th><th>Endereço</th><th>Volumes</th><th>Peso</th></tr></thead><tbody><% orderedStops.forEach(function(s,i){ %><tr><td><strong><%= i+1 %></strong></td><td><%= s.pv||'—' %></td><td><%= s.nf||'—' %></td><td><%= s.recipient||s.locationName %></td><td><%= [[s.street,s.number].filter(Boolean).join(', '),s.complement,s.neighborhood,[s.city,s.state].filter(Boolean).join('/')].filter(Boolean).join(' - ') %></td><td><%= s.volumes??'—' %></td><td><%= s.grossWeight==null?'—':`${formatNumber(s.grossWeight,3)} kg` %></td></tr><% }) %></tbody></table></div></section></main></body></html>
