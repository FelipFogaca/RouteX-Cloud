<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · RouteX</title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/topbar',{activePage:'schedule'}) %><main class="page-shell"><div class="page-heading"><div><span class="eyebrow">Reserva do veículo</span><h1><%= appointment.title %></h1><p><%= appointment.user_name %> · <%= formatDateTime(appointment.start_at) %> até <%= formatDateTime(appointment.end_at) %></p></div><div class="inline-actions"><% if(appointment.user_id===user.id||user.role==='admin'){ %><a class="button button-secondary" href="/schedule/<%= appointment.id %>/edit">Editar</a><% } %><a class="button button-ghost" href="/schedule">Calendário</a></div></div><%- include('partials/messages') %><section class="card"><div class="detail-grid"><div><span class="mini-label">Status</span><strong><%= appointment.status==='active'?'Ativo':'Cancelado' %></strong></div><div><span class="mini-label">Responsável</span><strong><%= appointment.user_name %></strong></div><div><span class="mini-label">Recorrência</span><strong><%= appointment.recurrence_type==='daily'?'Diária':'Única' %></strong></div><div><span class="mini-label">Período</span><strong><%= formatDateTime(appointment.start_at) %> → <%= formatDateTime(appointment.end_at) %></strong></div></div><% if(appointment.notes){ %><div class="detail-block"><span class="mini-label">Observações</span><p><%= appointment.notes %></p></div><% } %><div class="detail-block"><span class="mini-label">Rota e arquivos</span><div class="inline-actions"><% if(appointment.route_id){ %><a class="button button-secondary" href="/routes/<%= appointment.route_id %>">Abrir rota gerada</a><a class="button button-secondary" href="/routes/<%= appointment.route_id %>/export.xlsx">Baixar planilha da rota</a><% (appointment.map_links_json||[]).forEach(function(link){ %><a class="button button-maps" href="<%= link.url %>" target="_blank">Maps <%= link.part %> ↗</a><% }) %><% } %><% if(appointment.manual_route_url){ %><a class="button button-maps" href="<%= appointment.manual_route_url %>" target="_blank" rel="noopener">Link de rota ↗</a><% } %><% attachmentList.forEach(function(a){ %><a class="button button-ghost" href="/schedule/attachments/<%= a.id %>"><%= a.original_name %></a><% }) %><% if(!appointment.route_id&&!appointment.manual_route_url&&!attachmentList.length){ %><span class="muted">Nenhuma rota ou planilha associada.</span><% } %></div></div></section></main></body></html>
