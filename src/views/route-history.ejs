<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · RouteX</title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/topbar',{activePage:'routes'}) %><main class="page-shell"><div class="page-heading"><div><span class="eyebrow">Histórico operacional</span><h1>Rotas geradas</h1><p>Toda otimização concluída fica registrada na sua conta, com links do Maps e planilha reproduzível.</p></div><a class="button button-primary" href="/RouteX">Nova rota</a></div><%- include('partials/messages') %><section class="card"><div class="table-wrapper"><table><thead><tr><th>Gerada em</th><th>Rota</th><th>Paradas</th><th>Distância</th><th>Google Maps</th><th>Planilha</th></tr></thead><tbody><% if(!routes.length){ %><tr><td colspan="6" class="empty-table">Nenhuma rota gerada.</td></tr><% } %><% routes.forEach(function(r){ %><tr><td><%= formatDateTime(r.generated_at) %></td><td><a href="/routes/<%= r.id %>"><strong><%= r.title || 'Rota' %></strong></a><br><small><%= r.provider %> · <%= r.algorithm %></small></td><td><%= r.summary_json?.stopCount || 0 %></td><td><%= formatDistance(r.total_distance_meters) %></td><td><div class="inline-actions"><% (r.map_links_json||[]).forEach(function(link){ %><a class="button button-small button-maps" target="_blank" rel="noopener" href="<%= link.url %>">Trecho <%= link.part %> ↗</a><% }) %></div></td><td><a class="button button-small button-secondary" href="/routes/<%= r.id %>/export.xlsx">Baixar XLSX</a></td></tr><% }) %></tbody></table></div></section></main></body></html>
