<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · RouteX</title><link rel="stylesheet" href="/css/style.css"></head><body><%- include('partials/topbar',{activePage:'schedule'}) %><main class="page-shell"><div class="page-heading"><div><span class="eyebrow">Calendário compartilhado · Veículo único</span><h1>Agenda do veículo</h1><p>Todos os usuários enxergam as reservas. Horários sobrepostos são bloqueados no banco antes da confirmação.</p></div><a class="button button-primary" href="/schedule/new">+ Novo agendamento</a></div><%- include('partials/messages') %><section class="card calendar-card"><div class="calendar-toolbar"><a class="button button-ghost" href="/schedule?month=<%= prev %>">← Mês anterior</a><h2><%= month.setLocale('pt-BR').toFormat('LLLL yyyy') %></h2><a class="button button-ghost" href="/schedule?month=<%= next %>">Próximo mês →</a></div><div class="calendar-weekdays"><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span></div><div class="calendar-grid"><% days.forEach(function(day){ %><div class="calendar-day <%= day.inMonth?'':'outside' %> <%= day.isToday?'today':'' %>"><div class="calendar-day-head"><strong><%= day.day %></strong><a href="/schedule/new?date=<%= day.key %>">+</a></div><div class="calendar-events"><% (byDay[day.key]||[]).forEach(function(a){ %><a class="calendar-event" href="/schedule/<%= a.id %>" title="<%= a.title %> · <%= a.user_name %>"><span><%= formatDateTime(a.start_at).slice(11) %>–<%= formatDateTime(a.end_at).slice(11) %></span><strong><%= a.title %></strong><small><%= a.user_name %></small></a><% }) %></div></div><% }) %></div></section></main></body></html>
